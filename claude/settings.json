{
  "model": "claude-opus-5-5[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "compact-adviser@compact-adviser": true
  },
  "extraKnownMarketplaces": {
    "compact-adviser": {
      "source": {
        "source": "directory",
        "path": "/Users/shreejitverma/github/compact-adviser"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/github/agents/claude/hooks/guard.py\"; [ ! -f \"$f\" ] || exec python3 \"$f\" bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/github/agents/claude/hooks/guard.py\"; [ ! -f \"$f\" ] || exec python3 \"$f\" edit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/github/agents/claude/hooks/post_edit.py\"; [ ! -f \"$f\" ] || exec python3 \"$f\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
