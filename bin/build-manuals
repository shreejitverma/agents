#!/usr/bin/env bash
# build-manuals: compile one operating manual per AI tool from a single shared source.
#
# Each tool reads its own generated file, so no tool ever loads another tool's
# manual. The shared rules exist exactly once, in CORE.md, and are compiled into
# every build, so the three manuals cannot drift apart.
#
#   CORE.md        rules identical for every tool
#   ROUTING.md     which tool and model gets which task
#   tools/<t>.md   tuning for one tool only, additive, never restating CORE
#     -> build/<TOOL>.md
#
# Usage:
#   build-manuals            regenerate build/
#   build-manuals --check    verify build/ matches the sources; non-zero if stale
#
# --check is what ic-doctor runs, so a hand-edited or stale manual is caught
# instead of silently shipping different rules to different tools.
set -euo pipefail

REPO="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

TOOLS="claude grok gemini"
# AGENTS.md is the neutral default for any AGENTS.md reader (Codex and friends):
# shared core plus routing, with no tool-specific tuning, so no tool inherits
# another tool's manual.
NEUTRAL="agents"

# Advisory size budget per tool, in characters. Grok's README documents a
# 10,000-character cap per rules file; measured on Grok 1.0.34 it is not
# enforced, so this warns rather than fails. Re-measure with `grok inspect`
# after a Grok upgrade.
budget_for() {
  case "$1" in
    grok) echo 10000 ;;
    *)    echo 0 ;;   # 0 = no documented limit
  esac
}

upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

render() {  # <tool> -> manual on stdout
  local tool=$1
  if [ "$tool" = "$NEUTRAL" ]; then
    printf '<!-- Generated by bin/build-manuals from CORE.md and ROUTING.md. Do not edit this file; edit those. -->\n\n'
  else
    printf '<!-- Generated by bin/build-manuals from CORE.md, ROUTING.md and tools/%s.md. Do not edit this file; edit those. -->\n\n' "$tool"
  fi
  cat CORE.md
  printf '\n'
  cat ROUTING.md
  if [ "$tool" != "$NEUTRAL" ]; then
    printf '\n'
    cat "tools/$tool.md"
  fi
}

# A tuning file must never restate a shared rule: two copies of one rule are how
# manuals drift and how one tool ends up contradicting another. Compare only
# substantive lines, so shared headings and short list punctuation do not trip it.
check_no_restated_rules() {
  local tool=$1 dupes
  dupes=$(grep -vE '^\s*(#|$|\||-{3,})' "tools/$tool.md" \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
    | awk 'length($0) > 40' \
    | grep -Fxf <(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' CORE.md) - || true)
  if [ -n "$dupes" ]; then
    printf 'build-manuals: tools/%s.md restates rules that belong to CORE.md:\n' "$tool" >&2
    printf '  %s\n' "$dupes" >&2
    printf 'build-manuals: delete them from the tuning file; CORE.md is the single source.\n' >&2
    return 1
  fi
}

check_sources() {
  local missing=""
  for f in CORE.md ROUTING.md; do
    [ -f "$f" ] || missing="$missing $f"
  done
  for t in $TOOLS; do
    [ -f "tools/$t.md" ] || missing="$missing tools/$t.md"
  done
  if [ -n "$missing" ]; then
    printf 'build-manuals: missing source files:%s\n' "$missing" >&2
    return 1
  fi
}

mode=${1:-build}
case "$mode" in
  build|--check) ;;
  *) printf 'usage: build-manuals [--check]\n' >&2; exit 2 ;;
esac

check_sources
status=0
for tool in $TOOLS; do
  check_no_restated_rules "$tool" || status=1
done
[ "$status" -eq 0 ] || exit 1

for tool in $TOOLS $NEUTRAL; do
  out="$(upper "$tool").md"
  tmp="$(mktemp)"
  render "$tool" >"$tmp"

  size=$(wc -c <"$tmp" | tr -d ' ')
  budget=$(budget_for "$tool")
  if [ "$budget" -gt 0 ] && [ "$size" -gt "$budget" ]; then
    printf 'build-manuals: warning: %s is %s chars, over the %s documented for %s\n' \
      "$out" "$size" "$budget" "$tool" >&2
  fi

  if [ "$mode" = "--check" ]; then
    if ! cmp -s "$tmp" "$out"; then
      printf 'build-manuals: %s is stale or hand-edited (run: bin/build-manuals)\n' "$out" >&2
      status=1
    fi
    rm -f "$tmp"
  else
    mv "$tmp" "$out"
    printf 'build-manuals: wrote %s (%s chars)\n' "$out" "$size"
  fi
done

exit "$status"
